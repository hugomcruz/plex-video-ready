# Main backend JWT signing key
SECRET_KEY=replace_with_a_long_random_string

# Distribution server JWT signing key (independent of SECRET_KEY)
DIST_SECRET_KEY=replace_with_a_different_long_random_string

# Shared password used to issue dist-server service tokens
DIST_SERVICE_PASSWORD=replace_with_a_strong_password

# PostgreSQL password (used by postgres service and DATABASE_URL)
POSTGRES_PASSWORD=replace_with_a_strong_postgres_password
